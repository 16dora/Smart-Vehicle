CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 本板 OV3660 实测直接 PSRAM DMA 无法取得完整 JPEG；关闭后内部 DMA 中转取图通过。
# CONFIG_CAMERA_PSRAM_DMA is not set
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# 临时上板诊断：关闭 OLED，GPIO43/44 交还 UART0，COM3 以 115200 输出启动和应用日志。
# 固定母座可能把 GPIO20 接地；仅使用 CH340/UART0 烧录，不使用原生 USB。
# CONFIG_ESP_CONSOLE_NONE is not set
# CONFIG_BOOTLOADER_LOG_LEVEL_NONE is not set
# CONFIG_CAMERA_OLED_ENABLED is not set
# 网页、视频、运动三个服务独立运行，按 17 项预算并为 DHCP 等预留余量。
CONFIG_LWIP_MAX_SOCKETS=20
# 运动使用常连接二进制帧，握手前校验网页来源和控制连接唯一性。
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# 提高相机数据处理余量，并将相机任务与 CPU0 上的 Wi-Fi 任务分开。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 固定最高 CPU 频率，关闭系统动态电源管理及 STA 未连接时的调制解调器省电。
# CONFIG_PM_ENABLE is not set
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE is not set
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20
CONFIG_CAMERA_CORE1=y
# 05 工程固定同时启用热点和路由器连接，配置与 02 独立。
# PSRAM 场景使用预分配的 Wi-Fi 发送缓冲，减少逐包申请内部内存的压力。
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
# 保留 23 KiB TCP 发送缓冲；64 KiB 扩容实测没有改善吞吐。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
# OV3660 使用驱动 PLL 与 20 MHz 外部时钟；双缓冲存于 8 MB Octal PSRAM。
CONFIG_CAMERA_XCLK_FREQ_HZ=20000000
CONFIG_CAMERA_FRAME_BUFFERS=2
# 常规固件不开放硬件测量接口，也不持续输出任务运行时间。
# CONFIG_CAMERA_PERF_TEST is not set
# 网页运行状态独立启用空闲任务统计，使用固定微秒时钟计算双核忙碌率。
CONFIG_CAMERA_RUNTIME_STATS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
# 相机使用新版硬件 I2C1；车轮与机械臂统一使用软件 I2C，共享 GPIO39 时钟。
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
# 电机模块缺失时仅禁用运动，摄像头服务仍可正常启动。
CONFIG_MOTOR_ENABLED=y
CONFIG_MOTOR_I2C_ADDRESS=0x40
CONFIG_MOTOR_INVERT_MASK=0x0

# 可选机械臂缺失时不阻止相机与车轮；上电不输出舵机脉冲。
CONFIG_ARM_ENABLED=y
CONFIG_CAMERA_WIFI_APSTA=y
CONFIG_CAMERA_AP_SSID="SmartVehicle-CAM"
CONFIG_CAMERA_AP_PASSWORD="123456789"

# 两个机械臂关节的软件标称角度限位，单位为度。
CONFIG_ARM_JOINT0_MIN=5
CONFIG_ARM_JOINT0_MAX=175
CONFIG_ARM_JOINT1_MIN=5
CONFIG_ARM_JOINT1_MAX=175
# 弱信号实测中大帧聚合没有改善吞吐，保留原有 A-MPDU 和内部缓冲。
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=0
# CONFIG_ESP_WIFI_AMSDU_TX_ENABLED is not set
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_LWIP_TCP_WND_DEFAULT=23040
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
# 使用 1 ms 调度粒度，避免 30 FPS 限速被 10 ms 节拍向上取整。
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
